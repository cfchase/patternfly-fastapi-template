# OAuth2-Proxy Secret Configuration
#
# Copy this file to oauth2-proxy-secret.yaml and fill in your values.
# DO NOT commit the actual secret file to version control.
#
# For different providers, see:
# https://oauth2-proxy.github.io/oauth2-proxy/configuration/providers/
#
# Provider-specific examples below:

---
# Generic OIDC Provider (Keycloak, Auth0, Okta, etc.)
apiVersion: v1
kind: Secret
metadata:
  name: oauth2-proxy-secret
type: Opaque
stringData:
  # Provider type
  OAUTH2_PROXY_PROVIDER: "oidc"

  # OIDC Issuer URL (e.g., https://keycloak.example.com/realms/myrealm)
  OAUTH2_PROXY_OIDC_ISSUER_URL: "https://your-issuer-url"

  # OAuth Client credentials (get these from your identity provider)
  OAUTH2_PROXY_CLIENT_ID: "your-client-id"
  OAUTH2_PROXY_CLIENT_SECRET: "your-client-secret"

  # Cookie secret (generate with: openssl rand -base64 32 | head -c 32)
  OAUTH2_PROXY_COOKIE_SECRET: "your-32-character-cookie-secret!"

  # Redirect URL (must match your application's external URL)
  OAUTH2_PROXY_REDIRECT_URL: "https://your-app.example.com/oauth2/callback"

---
# GitHub Provider Example (alternative)
# apiVersion: v1
# kind: Secret
# metadata:
#   name: oauth2-proxy-secret
# type: Opaque
# stringData:
#   OAUTH2_PROXY_PROVIDER: "github"
#   OAUTH2_PROXY_CLIENT_ID: "your-github-client-id"
#   OAUTH2_PROXY_CLIENT_SECRET: "your-github-client-secret"
#   OAUTH2_PROXY_COOKIE_SECRET: "your-32-character-cookie-secret!"
#   OAUTH2_PROXY_REDIRECT_URL: "https://your-app.example.com/oauth2/callback"
#   # Optional: Restrict to specific GitHub org
#   # OAUTH2_PROXY_GITHUB_ORG: "your-org"

---
# Google Provider Example (alternative)
# apiVersion: v1
# kind: Secret
# metadata:
#   name: oauth2-proxy-secret
# type: Opaque
# stringData:
#   OAUTH2_PROXY_PROVIDER: "google"
#   OAUTH2_PROXY_CLIENT_ID: "your-google-client-id.apps.googleusercontent.com"
#   OAUTH2_PROXY_CLIENT_SECRET: "your-google-client-secret"
#   OAUTH2_PROXY_COOKIE_SECRET: "your-32-character-cookie-secret!"
#   OAUTH2_PROXY_REDIRECT_URL: "https://your-app.example.com/oauth2/callback"
